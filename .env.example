# Copy to .env (never commit .env). Real environment variables / Streamlit secrets also work.

# Which model judges candidates: auto | rule_based | gemini | openai_compatible
PROMOPILOT_MODEL=auto

# Google Gemini (free tier from https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Any OpenAI-style /chat/completions endpoint (a Kuku-provided API, OpenRouter, Groq, Ollama, ...)
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=

# Optional pipeline overrides (prefix PROMOPILOT_ + field name of config.PipelineConfig)
# PROMOPILOT_MAX_PROMOS_PER_EPISODE=3
# PROMOPILOT_MIN_TOTAL_SCORE=45
# PROMOPILOT_WEIGHTS=hook=30,cliffhanger=30,standalone=20,emotion=15,duration=5
